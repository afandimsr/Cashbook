APP_ENV=development

# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# LLM providers used to parse transaction messages, tried in this order: the
# next one is used only when the previous one fails (rate limit, 5xx,
# timeout). Supported: gemini, groq. Only listed providers need a key.
LLM_PROVIDERS=gemini,groq
# Max time for one provider attempt before falling back to the next.
LLM_PROVIDER_TIMEOUT=10s

# Gemini API key: https://ai.google.dev/gemini-api/docs/api-key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq (OpenAI-compatible, free plan): key at https://console.groq.com/keys
# Free-tier limits per model: https://console.groq.com/settings/limits
# GROQ_MODEL must support tool calling, e.g. openai/gpt-oss-120b or
# openai/gpt-oss-20b. On a "model_not_found" error, check for a replacement
# at https://console.groq.com/docs/deprecations (the models page can lag).
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# Reachable by container DNS name inside the shared docker network in production
# (see docker-compose.yaml), e.g. http://go-cashbook-backend:8181
BACKEND_BASE_URL=http://localhost:8181

# Must match backend's BOT_INTERNAL_API_KEY exactly
BACKEND_INTERNAL_API_KEY=
